@page "/"

<div class="hero">
    <div class="card hero-card">
        <h1>Welcome to <strong>CoreTemplate.AI</strong></h1>
        <p>Your modular AI playground with OpenRouter, Ollama, Function Calling & streaming.</p>

        <div class="btn-row" style="margin-bottom:24px;">
            <NavLink href="/chat" class="btn btn-primary">Try AI Chat</NavLink>
            <a href="https://openrouter.ai" target="_blank" class="btn btn-ghost">OpenRouter</a>
        </div>

        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon">🤖</div>
                <h3>OpenRouter</h3>
                <p>Access multiple frontier models behind a single API with smart routing.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🧱</div>
                <h3>Function Calling</h3>
                <p>Call your server-side tools with auto schema & secure dispatch.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🧠</div>
                <h3>Agents & Profiles</h3>
                <p>Define reusable system prompts, temperatures and behaviors.</p>
            </div>
        </div>
    </div>
</div>
